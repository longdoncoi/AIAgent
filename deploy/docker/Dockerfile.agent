# syntax=docker/dockerfile:1.7
# Pinned toolchain -- see Dockerfile.api for the rationale.
ARG PYTHON_BASE=python:3.12.11-slim-bookworm
ARG UV_VERSION=0.7.13

# Stage 1: Build & Dependencies
FROM ${PYTHON_BASE} AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:${UV_VERSION} /uv /usr/local/bin/uv

ENV VIRTUAL_ENV=/opt/venv \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
# Production enforces the neural reranker + embedding service: ship them.
RUN uv sync --frozen --no-dev --extra neural --active

# Stage 2: Hardened Non-Root Runtime
FROM ${PYTHON_BASE} AS runtime

# No `apt-get upgrade`: pinned, scanned base image only.
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY --chown=appuser:appgroup . /app

USER 10001:10001

ENV AGENT_MODULE="src.agentic.agents.chat.server"
ENV AGENT_PORT=9100

EXPOSE 9100 9101 9102

# A2A servers expose GET /health (create_a2a_server). No auth token needed.
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['AGENT_PORT']+'/health', timeout=5)"]

CMD ["sh", "-c", "uvicorn ${AGENT_MODULE}:app --host 0.0.0.0 --port ${AGENT_PORT}"]
