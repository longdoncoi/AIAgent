# Environment Configuration for agentic-platform

# API Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Model Serving & Gateway
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-dummy-key
DEFAULT_REASONING_MODEL=reasoning-llm
DEFAULT_FAST_MODEL=fast-llm
DEFAULT_CODING_MODEL=coding-llm
DEFAULT_EMBEDDING_MODEL=text-embedding-bge

# Direct Inference Endpoints (fallback / standalone)
VLLM_BASE_URL=http://localhost:8001/v1
LLAMA_CHAT_BASE_URL=http://localhost:8080/v1
LLAMA_EMBED_BASE_URL=http://localhost:8081/v1

# A2A Sub-Agents Endpoints
A2A_CHAT_AGENT_URL=http://localhost:9100/a2a
A2A_RAG_AGENT_URL=http://localhost:9101/a2a
A2A_CODING_AGENT_URL=http://localhost:9102/a2a

# MCP Tool Servers
MCP_CODE_EXEC_URL=http://localhost:9001/sse
MCP_REPO_URL=http://localhost:9002/sse
MCP_WEB_SEARCH_URL=http://localhost:9003/sse

# Storage & Databases
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/agentic_db

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Temporal Orchestration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentic-tasks

# Safety & Guardrails
ENABLE_GUARDRAILS=true
PII_REDACTION_ENABLED=true
MAX_EXECUTION_TIMEOUT_SECONDS=60

# Observability & LangSmith
ENABLE_TRACING=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-platform
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
